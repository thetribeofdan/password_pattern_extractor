# Password Pattern Extractor - Environment Template
# 
# Copy this file to .env and fill in your values for local development.
# Do not commit .env to version control.

# OpenAI API Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=

# Dataset paths (optional overrides - uses defaults if not set)
# RAW_DATASET_DIR=training_dataset/raw
# OUTPUT_DIR=output
# REVIEWS_DIR=target_builder/reviews
# FINE_TUNE_DIR=training_dataset/fine-tune

# Pipeline configuration
# CHUNK_SIZE=25
# NUM_WORKERS=4
#OPENAI_API_KEY=your_openai_api_key_here

# Logging
# LOG_LEVEL=INFO
